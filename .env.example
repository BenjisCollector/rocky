TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Writer LLM, only used when the text to type is not present in what you said. OpenAI-compatible.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1
TEXT_MODEL=deepseek-chat
# Voice
WAKE_WORD=watermelon
STT_BACKEND=auto          # auto | apple | whisper | windows
STT_LANGUAGE=en-US        # e.g. ar-SA for Arabic
# Confidence floors
ACTION_MIN_CONFIDENCE=0.45
DESTRUCTIVE_MIN_CONFIDENCE=0.8
